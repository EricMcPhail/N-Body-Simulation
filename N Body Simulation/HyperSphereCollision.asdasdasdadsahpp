class Graph {
public:
    // Adjacency list represented as a hash map
    std::unordered_map<int, std::unordered_set<int>> adj;

    // Function to add an edge
    void addDirectedEdge(int u, int v) {
        adj[u].insert(v);
    }

    void addUndirectedEdge(int u, int v) {
        addDirectedEdge(u, v);
        addDirectedEdge(v, u);
    }

    // Function to remove a vertex and all edges associated with it
    void removeVertex(int v) {
        // Check if the vertex exists
        if (adj.find(v) == adj.end()) return;

        // Iterate over the adjacency list of the vertex to be removed
        for (int neighbor : adj[v]) {
            // Remove the edge from the neighbor to the vertex
            adj[neighbor].erase(v);
        }

        // Remove the vertex from the graph
        adj.erase(v);
    }

    // Utility function to print the graph (for demonstration purposes)
    void printGraph() {
        for (auto& pair : adj) {
            std::cout << pair.first << ": ";
            for (int neighbor : pair.second) {
                std::cout << neighbor << " ";
            }
            std::cout << std::endl;
        }
    }


    void printGraph2() {
        for (auto& pair : adj) {
            int u = pair.first; // Current vertex
            for (int v : pair.second) {
                if (u < v) { // Ensure each edge is printed once
                    std::cout << u << " - " << v << std::endl;
                }
            }
        }
    }
};

int main2() {
    Graph g;
    g.addEdge(1, 2);
    g.addEdge(1, 3);
    g.addEdge(2, 4);
    g.addEdge(3, 4);
    g.addEdge(3, 5);

    std::cout << "Graph before removing vertex 3:\n";
    g.printGraph2();

    g.removeVertex(3);

    std::cout << "\nGraph after removing vertex 3:\n";
    g.printGraph2();

    return 0;
}

